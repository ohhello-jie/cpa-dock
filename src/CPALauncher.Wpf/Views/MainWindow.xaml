<hc:Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CPALauncher.Views.MainWindow" Title="CPA Dock" Width="1000" Height="780" MinWidth="860" MinHeight="660" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Microsoft YaHei UI" FontWeight="Normal" TextOptions.TextFormattingMode="Display" FontSize="13" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <hc:Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <SolidColorBrush x:Key="InkBrush" Color="#252A34" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A818F" />
        <SolidColorBrush x:Key="SoftMutedBrush" Color="#A0A6B1" />
        <SolidColorBrush x:Key="LineBrush" Color="#E4E7ED" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F6F7F9" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ActionBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ActionHoverBrush" Color="#ECEFF5" />
        <SolidColorBrush x:Key="LinkBrush" Color="#5265CE" />
        <SolidColorBrush x:Key="DockPrimaryBackgroundBrush" Color="#202632" />
        <SolidColorBrush x:Key="DockPrimaryForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5265CE" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF0FA" />
        <DrawingImage x:Key="BrandMark">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#202632" Geometry="M12,0 H52 Q64,0 64,12 V52 Q64,64 52,64 H12 Q0,64 0,52 V12 Q0,0 12,0Z" />
                    <GeometryDrawing Geometry="M18,39 V25 Q18,19 24,19 H43 M36,12 L43,19 L36,26 M46,25 V39 Q46,45 40,45 H21 M28,38 L21,45 L28,52">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="4.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource DockPrimaryBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DockPrimaryForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DockPrimaryBackgroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
            <Setter Property="Padding" Value="6,7" />
        </Style>
        <Style x:Key="Chrome" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Nav" CornerRadius="0" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Nav" Property="Background" Value="{DynamicResource ActionHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainNavigation" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="28,4,28,20" />
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.FontWeight="Normal" Margin="28,0,28,20" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="Track" Grid.Column="1" Width="32" Height="18" CornerRadius="9" Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Fill="White" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectionExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{x:Null}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{DynamicResource MutedBrush}" Height="30">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <TextBlock x:Name="Arrow" Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="16" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="⌃" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <DockPanel Margin="24,0,8,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource Chrome}" Content="" ToolTip="最小化" AutomationProperties.Name="最小化" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource Chrome}" Content="" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原" Click="OnMaximizeRestoreClick" />
                    <Button Style="{StaticResource Chrome}" Content="" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口" Click="OnCloseClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource BrandMark}" Width="26" Height="26" Margin="0,0,12,0" />
                    <TextBlock Text="CPA Dock" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" Padding="32,9" Visibility="{Binding IsImportNoticeVisible, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding ImportNoticeText}" TextWrapping="Wrap" />
        </Border>
        <TabControl Grid.Row="2" Style="{StaticResource MainNavigation}" SelectedIndex="{Binding SelectedPage}">
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="860" Margin="0,4,0,0">
                        <StackPanel Visibility="{Binding WelcomeVisibility}" Margin="0,20,0,30">
                            <TextBlock Text="添加 CPA" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="安装 CPA" Command="{Binding InstallCpaCommand}" Style="{StaticResource Primary}" Margin="0,0,12,0" />
                                <Button Content="选择已有安装" Command="{Binding GoSettingsCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Hint}" Margin="0,16,0,0" Visibility="{Binding UpdateStatusVisibility}" />
                            <ProgressBar Height="3" Value="{Binding UpdateProgress}" Visibility="{Binding UpdateProgressVisibility}" Margin="0,12,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ServiceVisibility}">
                            <Grid Margin="0,4,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CLIProxyAPI" FontSize="22" FontWeight="SemiBold" Margin="0,0,20,0" />
                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusForegroundBrush}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <Button Content="打开管理页 ↗" Command="{Binding OpenManagementCommand}" Visibility="{Binding ReadyActionVisibility}" Style="{StaticResource Primary}" />
                                    <Button Content="启动 CPA" Command="{Binding StartCommand}" Visibility="{Binding StartActionVisibility}" Style="{StaticResource Primary}" />
                                    <Button Content="停止" Command="{Binding StopCommand}" Visibility="{Binding StopActionVisibility}" Margin="8,0,0,0" />
                                    <Button Content="诊断" Command="{Binding GoDiagnosticsCommand}" Visibility="{Binding ExternalNoticeVisibility}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,8">
                                <StackPanel>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="服务地址" Foreground="{DynamicResource MutedBrush}" />
                                        <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EndpointDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EndpointDisplay}" />
                                        </Grid>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="复制" Command="{Binding CopyServiceUrlCommand}" Style="{StaticResource Link}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="管理密钥" Foreground="{DynamicResource MutedBrush}" />
                                        <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ManagementSecretKeyDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ManagementSecretKeyDisplay}" />
                                        </Grid>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="复制" Command="{Binding CopyManagementSecretKeyCommand}" Style="{StaticResource Link}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Height="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="凭证" Foreground="{DynamicResource MutedBrush}" />
                                <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CredentialsSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CredentialsSummary}" />
                                </Grid>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="目录" Command="{Binding OpenAuthDirectoryCommand}" Style="{StaticResource Link}" Margin="0,0,16,0" />
                                    <Button Content="导入" Command="{Binding ImportCredentialsCommand}" ToolTip="{Binding CredentialActivationHint}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button Content="全部日志 →" Command="{Binding GoDiagnosticsCommand}" Style="{StaticResource Link}" DockPanel.Dock="Right" Padding="0,4" />
                                    <TextBlock Text="最近日志" FontWeight="SemiBold" />
                                </DockPanel>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16" MinHeight="80">
                                    <TextBlock Text="{Binding LatestActivityText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="-6,12,0,0">
                                    <Button Content="日志目录" Command="{Binding OpenLogsCommand}" Style="{StaticResource Link}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="诊断">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="进程" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding ProcessCheckText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessCheckText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0">
                                <TextBlock Text="配置" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding ConfigurationCheckText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationCheckText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="16,0">
                                <TextBlock Text="HTTP" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding HttpCheckText}" ToolTip="{Binding ProbeUrlDisplay}" />
                            </StackPanel>
                            <Button Content="检查" Command="{Binding RefreshCommand}" Grid.Column="3" Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Grid Width="220" Margin="0,0,12,0">
                                <TextBox x:Name="LogSearchBox" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索日志" Height="34" />
                                <TextBlock Text="搜索日志" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SoftMutedBrush}" IsHitTestVisible="False" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=LogSearchBox, Path=Text}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox Foreground="{DynamicResource InkBrush}" SelectedIndex="{Binding LogScope}" Width="120" VerticalContentAlignment="Center" AutomationProperties.Name="日志筛选" Height="34">
                                <ComboBoxItem Foreground="{DynamicResource InkBrush}" Content="全部日志" />
                                <ComboBoxItem Foreground="{DynamicResource InkBrush}" Content="错误与失败" />
                                <ComboBoxItem Foreground="{DynamicResource InkBrush}" Content="启动器" />
                                <ComboBoxItem Foreground="{DynamicResource InkBrush}" Content="CPA 输出" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="日志" FontWeight="SemiBold" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Grid.Row="3" Padding="8" CornerRadius="8">
                        <Grid>
                            <TextBlock Text="无" Foreground="{DynamicResource SoftMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=DiagnosticListBox, Path=Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox x:Name="DiagnosticListBox" ItemsSource="{Binding DiagnosticView}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InkBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsVisibleChanged="OnDiagnosticVisibilityChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="复制当前" Command="{Binding CopyVisibleLogsCommand}" Style="{StaticResource Link}" />
                            <Button Content="复制全部" Command="{Binding CopyLogsCommand}" Style="{StaticResource Link}" />
                            <Button Content="导出" Command="{Binding ExportLogsCommand}" Style="{StaticResource Link}" />
                            <Button Content="清空" Command="{Binding ClearLogsCommand}" Style="{StaticResource Link}" />
                        </StackPanel>
                        <CheckBox Content="跟随日志" IsChecked="{Binding AutoScrollLogs}" ToolTip="取消后可停留在历史日志；最多保留 400 行。" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="860" Margin="0,0,8,0">
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="{Binding ConfigurationVisibilityActionText}" Command="{Binding ToggleConfigurationInfoVisibilityCommand}" Style="{StaticResource Link}" DockPanel.Dock="Right" Padding="0,4" />
                            <TextBlock Text="服务配置" FontWeight="SemiBold" />
                        </DockPanel>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,6">
                            <StackPanel>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="程序" Foreground="{DynamicResource MutedBrush}" />
                                    <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ExecutablePathDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePathDisplay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="目录" Command="{Binding OpenExecutableDirCommand}" Style="{StaticResource Link}" />
                                        <Button Content="选择" Command="{Binding BrowseExecutableCommand}" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="配置" Foreground="{DynamicResource MutedBrush}" />
                                    <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ConfigPathDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigPathDisplay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="编辑" Command="{Binding OpenConfigurationFileCommand}" Style="{StaticResource Link}" />
                                        <Button Content="目录" Command="{Binding OpenConfigDirCommand}" Style="{StaticResource Link}" />
                                        <Button Content="选择" Command="{Binding BrowseConfigCommand}" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Expander Header="连接信息" Style="{StaticResource ConnectionExpander}" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}">
                                    <StackPanel Margin="0,8,0,4">
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="监听" Foreground="{DynamicResource MutedBrush}" />
                                            <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ListenerDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ListenerDisplay}" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="管理页" Foreground="{DynamicResource MutedBrush}" />
                                            <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ManagementUrlDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ManagementUrlDisplay}" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="凭证目录" Foreground="{DynamicResource MutedBrush}" />
                                            <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AuthDirectoryDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AuthDirectoryDisplay}" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="目录" Command="{Binding OpenAuthDirectoryCommand}" Style="{StaticResource Link}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="偏好" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,4">
                                <StackPanel>
                                    <CheckBox Content="登录时打开 CPA Dock" IsChecked="{Binding LaunchOnWindowsStartup}" Style="{StaticResource SettingSwitch}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.ColumnSpan="2" Content="自动启动 CPA" IsChecked="{Binding AutoStartService}" Style="{StaticResource SettingSwitch}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,52,0">
                                            <TextBlock Text="延迟" Style="{StaticResource Hint}" Margin="0,0,8,0" />
                                            <hc:NumericUpDown Value="{Binding AutoStartDelaySeconds}" Minimum="0" Maximum="300" Width="78" Height="28" VerticalContentAlignment="Center" AutomationProperties.Name="启动延迟秒数" />
                                            <TextBlock Text="秒" Style="{StaticResource Hint}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="启动后打开管理页" IsChecked="{Binding OpenManagementPageAfterStart}" Style="{StaticResource SettingSwitch}" />
                                    <CheckBox Content="关闭到托盘" IsChecked="{Binding MinimizeToTrayOnClose}" Style="{StaticResource SettingSwitch}" />
                                    <CheckBox Content="深色模式" IsChecked="{Binding IsDarkMode}" Style="{StaticResource SettingSwitch}" />
                                    <CheckBox Content="自动检查 CPA 更新" IsChecked="{Binding CheckForUpdatesOnStartup}" Style="{StaticResource SettingSwitch}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <DockPanel Margin="0,16,0,8">
                            <Button Content="检查全部" Command="{Binding CheckAllUpdatesCommand}" Style="{StaticResource Link}" DockPanel.Dock="Right" Padding="0,4" />
                            <TextBlock Text="版本" FontWeight="SemiBold" />
                        </DockPanel>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,6">
                            <StackPanel>
                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPA Dock" Foreground="{DynamicResource MutedBrush}" />
                                    <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LauncherCurrentVersionDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LauncherCurrentVersionDisplay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding LauncherUpdateActionText}" Command="{Binding CheckLauncherUpdateCommand}" MinWidth="94" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding LauncherUpdateStatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding LauncherUpdateStatusText}" Margin="96,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LauncherUpdateStatusText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Height="3" Value="{Binding LauncherUpdateProgress}" Visibility="{Binding LauncherUpdateProgressVisibility}" Margin="96,0,0,8" />
                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CLIProxyAPI" Foreground="{DynamicResource MutedBrush}" />
                                    <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentCpaVersionDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentCpaVersionDisplay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding UpdateActionText}" Command="{Binding CheckForUpdateCommand}" MinWidth="94" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding UpdateStatusText}" Margin="96,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateStatusText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Height="3" Value="{Binding UpdateProgress}" Visibility="{Binding UpdateProgressVisibility}" Margin="96,0,0,8" />
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,12,0,0">
                            <Button Content="退出 CPA Dock" Command="{Binding ExitApplicationCommand}" Style="{StaticResource Link}" DockPanel.Dock="Right" />
                            <StackPanel Orientation="Horizontal" Margin="-6,0,0,0">
                                <Button Content="GitHub ↗" Command="{Binding OpenRepositoryCommand}" Style="{StaticResource Link}" Margin="0,0,16,0" />
                                <Button Content="CLIProxyAPI ↗" Command="{Binding OpenCpaRepositoryCommand}" Style="{StaticResource Link}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <DockPanel>
                <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource Hint}" DockPanel.Dock="Right" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Fill="{Binding StatusForegroundBrush}" Width="6" Height="6" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding FooterStatusText}" Style="{StaticResource Hint}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.RowSpan="4" Background="#88131F18" Visibility="{Binding IsTokenDropOverlayVisible, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
            <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36" BorderBrush="{Binding TokenDropAccentBrush}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{Binding TokenDropTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TokenDropSubtitle}" Style="{StaticResource Hint}" Margin="0,12,0,0" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
        <StackPanel x:Name="MainGrowlPanel" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="0,72,24,0" Panel.ZIndex="20" />
    </Grid>
</hc:Window>