<hc:Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CPALauncher.Views.MainWindow" Title="CPA Dock" Width="900" Height="560" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI, Microsoft YaHei UI" FontWeight="Normal" TextOptions.TextFormattingMode="Display" FontSize="13" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop" SizeToContent="Manual" MaxWidth="1100" MaxHeight="720">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <hc:Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DockIcons.xaml"/>
        <ResourceDictionary Source="DockControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="SidebarBrush" Color="#FAFAFA"/>
      <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
      <SolidColorBrush x:Key="InkBrush" Color="#23262C"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#777D86"/>
      <SolidColorBrush x:Key="SoftMutedBrush" Color="#9298A1"/>
      <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB"/>
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#F5F6F7"/>
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ActionBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ActionHoverBrush" Color="#EFF0F2"/>
      <SolidColorBrush x:Key="LinkBrush" Color="#23262C"/>
      <SolidColorBrush x:Key="DockPrimaryBackgroundBrush" Color="#292C31"/>
      <SolidColorBrush x:Key="DockPrimaryForegroundBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#292C31"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#F5F6F7"/>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{DynamicResource ActionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="Opacity" Value="0.65"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.38"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource DockPrimaryBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DockPrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DockPrimaryBackgroundBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
      </Style>
      <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
        <Setter Property="Padding" Value="6,7"/>
      </Style>
      <Style x:Key="Chrome" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
      </Style>
      <Style x:Key="SettingSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center"/>
                <Border x:Name="Track" Grid.Column="1" Width="33" Height="19" CornerRadius="9" Background="{DynamicResource SwitchBrush}" VerticalAlignment="Center">
                  <Ellipse x:Name="Thumb" Fill="White" Width="13" Height="13" HorizontalAlignment="Left" Margin="3,0"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource DockPrimaryForegroundBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
                  <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <SolidColorBrush x:Key="SwitchBrush" Color="#CBCED3"/>
      <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Padding" Value="0"/>
      </Style>
      <Style x:Key="ThemeChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      </Style>
      <Style x:Key="NavItem" TargetType="TabItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border x:Name="Nav" CornerRadius="6" Background="Transparent" Padding="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ContentControl ContentTemplate="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" Width="16" Height="16" Margin="0,0,12,0"/>
                  <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Nav" Property="Background" Value="{DynamicResource CardBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Nav" Property="Background" Value="{DynamicResource PanelBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                  <Setter TargetName="Nav" Property="BorderThickness" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MainNavigation" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabControl">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="46"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource CardBrush}" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                  <Grid Margin="20,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <ContentControl ContentTemplate="{StaticResource IconArrowLeftRight}" Width="16" Height="16" Margin="0,0,9,0"/>
                      <TextBlock Text="CPA Dock" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Style="{StaticResource Chrome}" ToolTip="最小化" AutomationProperties.Name="最小化" Click="OnMinimizeClick">
                        <ContentControl ContentTemplate="{StaticResource IconMinus}" Width="16" Height="16"/>
                      </Button>
                      <Button Style="{StaticResource Chrome}" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口" Click="OnCloseClick">
                        <ContentControl ContentTemplate="{StaticResource IconX}" Width="16" Height="16"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="146"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Sidebar" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="12,21,12,18">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel IsItemsHost="True" VerticalAlignment="Top" KeyboardNavigation.TabNavigation="Once"/>
                      <DockPanel Grid.Row="1" Margin="12,0" LastChildFill="False">
                        <TextBlock Text="CPA Dock" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding LauncherCurrentVersionDisplay}" FontSize="11" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right"/>
                      </DockPanel>
                    </Grid>
                  </Border>
                  <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="64"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PageTitle" Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="18" FontWeight="SemiBold" Margin="28,0" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" Padding="28,9" Visibility="{Binding IsImportNoticeVisible, Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="{Binding ImportNoticeText}" TextWrapping="Wrap"/>
                    </Border>
                    <ContentPresenter Grid.Row="2" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.FontWeight="Normal" Margin="28,0,28,22" HorizontalAlignment="Stretch"/>
                  </Grid>
                </Grid>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ConnectionExpander" TargetType="Expander">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <StackPanel>
                <ToggleButton Style="{x:Null}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{DynamicResource MutedBrush}" Height="34">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ContentControl ContentTemplate="{StaticResource IconChevronRight}" Width="16" Height="16" VerticalAlignment="Center" x:Name="Arrow" HorizontalAlignment="Right" RenderTransformOrigin=".5,.5"/>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Arrow" Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="90"/>
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </hc:Window.Resources>
  <Grid>
    <TabControl x:Name="MainTabs" Style="{StaticResource MainNavigation}" SelectedIndex="{Binding SelectedPage}">
      <TabItem Header="概览" Tag="{StaticResource IconLayoutGrid}">
        <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch" Style="{StaticResource DockScrollViewer}">
          <Grid x:Name="OverviewContent" VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=OverviewScroll}" MinHeight="339">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="OverviewSummary" VerticalAlignment="Top">
              <StackPanel Visibility="{Binding WelcomeVisibility}" Margin="0,16,0,24">
                <TextBlock Text="添加 CPA" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="安装 CPA" Command="{Binding InstallCpaCommand}" Style="{StaticResource Primary}" Margin="0,0,12,0"/>
                  <Button Content="选择已有安装" Command="{Binding GoSettingsCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Hint}" Margin="0,16,0,0" Visibility="{Binding UpdateStatusVisibility}"/>
                <ProgressBar Height="3" Value="{Binding UpdateProgress}" Visibility="{Binding UpdateProgressVisibility}" Margin="0,12,0,0"/>
              </StackPanel>
              <StackPanel Visibility="{Binding ServiceVisibility}">
                <Grid Height="80" Margin="0,0,0,0" x:Name="ServiceHeader">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <StackPanel VerticalAlignment="Top" x:Name="ServiceIdentity" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="CLIProxyAPI" FontSize="21" FontWeight="SemiBold" Margin="0,0,12,0"/>
                      <Ellipse Width="7" Height="7" Fill="{Binding StatusForegroundBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hint}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1" Margin="16,0,0,25" x:Name="ServiceActions">
                    <Button Command="{Binding OpenManagementCommand}" Style="{StaticResource Primary}" Visibility="{Binding ReadyActionVisibility}" AutomationProperties.Name="打开管理页">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="打开管理页" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <ContentControl ContentTemplate="{StaticResource IconArrowUpRight}" Width="16" Height="16" Margin="7,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <Button Content="启动 CPA" Command="{Binding StartCommand}" Style="{StaticResource Primary}" Visibility="{Binding StartActionVisibility}"/>
                    <Button Content="停止" Command="{Binding StopCommand}" Visibility="{Binding StopActionVisibility}" Margin="8,0,0,0"/>
                    <Button Content="诊断" Command="{Binding GoDiagnosticsCommand}" Visibility="{Binding ExternalNoticeVisibility}" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
                <Grid Height="44" Tag="OverviewRow">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="服务地址" Foreground="{DynamicResource MutedBrush}"/>
                  <Grid Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="{Binding EndpointDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EndpointDisplay}"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                    <Button Style="{StaticResource IconButton}" Command="{Binding CopyServiceUrlCommand}" ToolTip="复制服务地址" AutomationProperties.Name="复制服务地址">
                      <ContentControl ContentTemplate="{StaticResource IconCopy}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}"/>
                <Grid Height="44" Tag="OverviewRow">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="管理密钥" Foreground="{DynamicResource MutedBrush}"/>
                  <Grid Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="{Binding ManagementSecretKeyDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ManagementSecretKeyDisplay}"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                    <Button Style="{StaticResource IconButton}" Command="{Binding CopyManagementSecretKeyCommand}" ToolTip="复制管理密钥" AutomationProperties.Name="复制管理密钥">
                      <ContentControl ContentTemplate="{StaticResource IconCopy}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}"/>
                <Grid Height="54" Tag="OverviewRow">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="凭证" Foreground="{DynamicResource MutedBrush}"/>
                  <Grid Grid.Column="1" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CredentialsSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CredentialsSummary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding AuthDirectoryDisplay}" ToolTip="{Binding AuthDirectoryDisplay}" TextTrimming="CharacterEllipsis" MaxWidth="160" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenAuthDirectoryCommand}" ToolTip="打开凭证目录" AutomationProperties.Name="打开凭证目录" Margin="0,0,4,0">
                      <ContentControl ContentTemplate="{StaticResource IconFolderOpen}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ImportCredentialsCommand}" ToolTip="导入凭证" AutomationProperties.Name="导入凭证">
                      <ContentControl ContentTemplate="{StaticResource IconFileInput}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,18,0,0" x:Name="RecentLogSection">
              <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Height="34" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                  <Button Style="{StaticResource IconButton}" Command="{Binding GoDiagnosticsCommand}" ToolTip="全部日志" AutomationProperties.Name="全部日志">
                    <ContentControl ContentTemplate="{StaticResource IconArrowUpRight}" Width="16" Height="16" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
                <TextBlock Text="最近日志" FontWeight="SemiBold"/>
              </DockPanel>
              <Border Grid.Row="1" x:Name="RecentLogSurface" Background="{DynamicResource PanelBrush}" CornerRadius="5" Padding="12,10" SizeChanged="OnRecentLogSizeChanged">
                  <Grid>
                    <TextBlock Text="无" Style="{StaticResource Hint}" HorizontalAlignment="Center" Height="24" Visibility="{Binding RecentEmptyVisibility}"/>
                    <ItemsControl x:Name="RecentLogItems" ItemsSource="{Binding RecentActivityLines}" Visibility="{Binding RecentActivityVisibility}" VerticalAlignment="Top">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" Height="26" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="诊断" Tag="{StaticResource IconTerminal}">
        <Grid MinHeight="240">
          <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
          </Grid.RowDefinitions>
          <Border Background="Transparent" CornerRadius="0" Padding="0,0,0,14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="进程" Style="{StaticResource Hint}" Margin="0,0,9,0"/>
                <TextBlock Text="{Binding ProcessCheckText}" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessCheckText}"/>
              </Grid>
              <Grid Grid.Column="1" Margin="0,0,18,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="配置" Style="{StaticResource Hint}" Margin="0,0,9,0"/>
                <TextBlock Text="{Binding ConfigurationCheckText}" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationCheckText}"/>
              </Grid>
              <Grid Grid.Column="2" Margin="0,0,18,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="HTTP" Style="{StaticResource Hint}" Margin="0,0,9,0"/>
                <TextBlock Text="{Binding HttpCheckText}" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding HttpCheckText}"/>
              </Grid>
              <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="重新检查" AutomationProperties.Name="重新检查" Grid.Column="3">
                <ContentControl ContentTemplate="{StaticResource IconRefreshCw}" Width="16" Height="16" VerticalAlignment="Center"/>
              </Button>
            </Grid>
          </Border>
          <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,10,0" x:Name="SearchField" Height="34">
              <TextBox x:Name="LogSearchBox" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索日志" Height="34" Padding="32,0,10,0" Style="{StaticResource DockSearchBox}"/>
              <ContentControl ContentTemplate="{StaticResource IconSearch}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" x:Name="SearchIcon"/>
              <TextBlock Text="搜索日志" Margin="32,0,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="13" IsHitTestVisible="False" x:Name="SearchPlaceholder" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ElementName=LogSearchBox, Path=Text}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <ComboBox Foreground="{DynamicResource InkBrush}" SelectedIndex="{Binding LogScope}" Width="108" VerticalContentAlignment="Center" AutomationProperties.Name="日志筛选" Height="34" x:Name="LogFilter" Grid.Column="1">
              <ComboBoxItem Content="全部日志"/>
              <ComboBoxItem Content="错误与失败"/>
              <ComboBoxItem Content="启动器"/>
              <ComboBoxItem Content="CPA 输出"/>
            </ComboBox>
          </Grid>
          <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="5" Padding="4,12">
            <Grid>
              <TextBlock Text="无" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ElementName=DiagnosticListBox, Path=Items.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ListBox x:Name="DiagnosticListBox" ItemsSource="{Binding DiagnosticView}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InkBrush}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsVisibleChanged="OnDiagnosticVisibilityChanged" Style="{StaticResource DockLogList}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <DockPanel Grid.Row="3" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
              <Button Style="{StaticResource IconButton}" Command="{Binding CopyVisibleLogsCommand}" ToolTip="复制当前日志" AutomationProperties.Name="复制当前日志" Margin="8,0,0,0">
                <ContentControl ContentTemplate="{StaticResource IconCopy}" Width="16" Height="16" VerticalAlignment="Center"/>
              </Button>
              <Button Style="{StaticResource IconButton}" Command="{Binding CopyLogsCommand}" ToolTip="复制全部日志" AutomationProperties.Name="复制全部日志" Margin="8,0,0,0">
                <ContentControl ContentTemplate="{StaticResource IconCopyPlus}" Width="16" Height="16" VerticalAlignment="Center"/>
              </Button>
              <Button Style="{StaticResource IconButton}" Command="{Binding ExportLogsCommand}" ToolTip="导出日志" AutomationProperties.Name="导出日志" Margin="8,0,0,0">
                <ContentControl ContentTemplate="{StaticResource IconDownload}" Width="16" Height="16" VerticalAlignment="Center"/>
              </Button>
              <Button Style="{StaticResource IconButton}" Command="{Binding ClearLogsCommand}" ToolTip="清空日志" AutomationProperties.Name="清空日志" Margin="8,0,0,0">
                <ContentControl ContentTemplate="{StaticResource IconTrash2}" Width="16" Height="16" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
            <CheckBox Content="跟随日志" IsChecked="{Binding AutoScrollLogs}" ToolTip="最多保留 400 行" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="设置" Tag="{StaticResource IconSettings2}">
        <Grid x:Name="SettingsViewport">
          <ScrollViewer x:Name="SettingsScroll" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Style="{StaticResource DockScrollViewer}">
            <Grid x:Name="SettingsContent" VerticalAlignment="Top">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="SettingsServiceGroup">
                <DockPanel Height="30" Tag="SectionHeading">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Command="{Binding ToggleConfigurationInfoVisibilityCommand}" ToolTip="{Binding ConfigurationVisibilityActionText}" AutomationProperties.Name="{Binding ConfigurationVisibilityActionText}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                          <Setter Property="ContentTemplate" Value="{StaticResource IconEyeOff}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ConfigurationVisibilityActionText}" Value="显示信息">
                              <Setter Property="ContentTemplate" Value="{StaticResource IconEye}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                  <TextBlock Text="服务" FontWeight="SemiBold"/>
                </DockPanel>
                <Grid Height="38" Tag="SettingsRow:43">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="程序"/>
                  <Grid Grid.Column="1" Margin="12,0,12,0">
                    <Border Height="32" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="11,0" Tag="SettingsField">
                      <TextBlock Text="{Binding ExecutablePathDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePathDisplay}"/>
                    </Border>
                  </Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenExecutableDirCommand}" ToolTip="打开程序目录" AutomationProperties.Name="打开程序目录" Margin="0,0,4,0">
                      <ContentControl ContentTemplate="{StaticResource IconFolderOpen}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding BrowseExecutableCommand}" ToolTip="选择程序" AutomationProperties.Name="选择程序">
                      <ContentControl ContentTemplate="{StaticResource IconFileSearch}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <Grid Height="38" Tag="SettingsRow:43">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="配置"/>
                  <Grid Grid.Column="1" Margin="12,0,12,0">
                    <Border Height="32" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="11,0" Tag="SettingsField">
                      <TextBlock Text="{Binding ConfigPathDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigPathDisplay}"/>
                    </Border>
                  </Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenConfigurationFileCommand}" ToolTip="编辑配置" AutomationProperties.Name="编辑配置" Margin="0,0,4,0">
                      <ContentControl ContentTemplate="{StaticResource IconSquarePen}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding BrowseConfigCommand}" ToolTip="选择配置" AutomationProperties.Name="选择配置">
                      <ContentControl ContentTemplate="{StaticResource IconFileSearch}" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <Expander Header="连接信息" Style="{StaticResource ConnectionExpander}" x:Name="ConnectionDetails">
                  <StackPanel>
                    <Grid Height="38" Tag="SettingsRow:38">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="监听" Foreground="{DynamicResource MutedBrush}"/>
                      <Grid Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding ListenerDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ListenerDisplay}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2"/>
                    </Grid>
                    <Grid Height="38" Tag="SettingsRow:38">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="管理页" Foreground="{DynamicResource MutedBrush}"/>
                      <Grid Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding ManagementUrlDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ManagementUrlDisplay}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenManagementCommand}" ToolTip="打开管理页" AutomationProperties.Name="打开管理页">
                          <ContentControl ContentTemplate="{StaticResource IconArrowUpRight}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Grid Height="38" Tag="SettingsRow:38">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="凭证目录" Foreground="{DynamicResource MutedBrush}"/>
                      <Grid Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding AuthDirectoryDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AuthDirectoryDisplay}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenAuthDirectoryCommand}" ToolTip="打开凭证目录" AutomationProperties.Name="打开凭证目录">
                          <ContentControl ContentTemplate="{StaticResource IconFolderOpen}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Grid Height="38" Tag="SettingsRow:38">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="日志目录" Foreground="{DynamicResource MutedBrush}"/>
                      <Grid Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding LogDirectoryDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogDirectoryDisplay}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenLogsCommand}" ToolTip="打开日志目录" AutomationProperties.Name="打开日志目录">
                          <ContentControl ContentTemplate="{StaticResource IconFolderOpen}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Expander>
              </StackPanel>
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0" x:Name="SettingsPreferencesGroup" Grid.Row="1">
                <StackPanel>
                  <DockPanel Height="26" Tag="SectionHeading">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    <TextBlock Text="偏好" FontWeight="SemiBold"/>
                  </DockPanel>
                  <CheckBox Content="登录时打开 CPA Dock" IsChecked="{Binding LaunchOnWindowsStartup}" Style="{StaticResource SettingSwitch}" AutomationProperties.Name="登录时打开 CPA Dock"/>
                  <Grid Height="36" Tag="SettingsRow:40">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.ColumnSpan="2" Content="自动启动 CPA" IsChecked="{Binding AutoStartService}" Style="{StaticResource SettingSwitch}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,54,0" Visibility="{Binding AutoStartService, Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="延迟" Style="{StaticResource Hint}" Margin="0,0,8,0"/>
                      <hc:NumericUpDown Value="{Binding AutoStartDelaySeconds}" Minimum="0" Maximum="300" Width="60" Height="28" VerticalContentAlignment="Center" AutomationProperties.Name="启动延迟秒数"/>
                      <TextBlock Text="秒" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Grid>
                  <CheckBox Content="启动后打开管理页" IsChecked="{Binding OpenManagementPageAfterStart}" Style="{StaticResource SettingSwitch}" AutomationProperties.Name="启动后打开管理页"/>
                  <CheckBox Content="关闭到托盘" IsChecked="{Binding MinimizeToTrayOnClose}" Style="{StaticResource SettingSwitch}" AutomationProperties.Name="关闭到托盘"/>
                  <Grid Height="36" Tag="SettingsRow:40">
                    <TextBlock Text="外观"/>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Button Content="浅色" Command="{Binding SetLightThemeCommand}">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkMode}" Value="False">
                                  <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                  <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="深色" Command="{Binding SetDarkThemeCommand}" Margin="2,0,0,0">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                  <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0" x:Name="SettingsVersionGroup" Grid.Row="2">
                <Expander Header="版本与更新" Style="{StaticResource ConnectionExpander}" x:Name="VersionDetails">
                <Grid x:Name="VersionLayout">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel x:Name="LauncherVersionGroup" Grid.Row="1">
                    <Grid Height="38" Tag="SettingsRow:43">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="CPA Dock" Foreground="{DynamicResource MutedBrush}"/>
                      <Grid Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding LauncherCurrentVersionDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LauncherCurrentVersionDisplay}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
<Button Style="{StaticResource IconButton}" ToolTip="更多" AutomationProperties.Name="更多" Click="OnMoreClick">
                        <Button.ContextMenu>
                          <ContextMenu Placement="Bottom" HorizontalOffset="0" VerticalOffset="4" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="检查全部更新" Command="{Binding CheckAllUpdatesCommand}"/>
                            <MenuItem Header="打开配置目录" Command="{Binding OpenConfigDirCommand}"/>
                            <MenuItem Header="打开日志目录" Command="{Binding OpenLogsCommand}"/>
                            <Separator/>
                            <MenuItem Header="CPA Dock · GitHub" Command="{Binding OpenRepositoryCommand}"/>
                            <MenuItem Header="CLIProxyAPI · GitHub" Command="{Binding OpenCpaRepositoryCommand}"/>
                          </ContextMenu>
                        </Button.ContextMenu>
                        <ContentControl ContentTemplate="{StaticResource IconMoreHorizontal}" Width="16" Height="16" VerticalAlignment="Center"/>
                      </Button>
                        <Button Content="{Binding LauncherUpdateActionText}" Command="{Binding CheckLauncherUpdateCommand}"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding LauncherUpdateStatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LauncherUpdateStatusText}" Margin="96,0,0,4" FontSize="12" Foreground="{DynamicResource MutedBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding LauncherUpdateStatusText}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Height="3" Value="{Binding LauncherUpdateProgress}" Visibility="{Binding LauncherUpdateProgressVisibility}" Margin="96,0,0,8"/>
                  </StackPanel>
                  <StackPanel x:Name="CpaVersionGroup" Grid.Row="2">
                    <Grid Height="38" Tag="SettingsRow:43">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="CLIProxyAPI" Foreground="{DynamicResource MutedBrush}"/>
                      <Grid Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding CurrentCpaVersionDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentCpaVersionDisplay}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                        <Button Content="{Binding UpdateActionText}" Command="{Binding CheckForUpdateCommand}"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding UpdateStatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding UpdateStatusText}" Margin="96,0,0,4" FontSize="12" Foreground="{DynamicResource MutedBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateStatusText}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Height="3" Value="{Binding UpdateProgress}" Visibility="{Binding UpdateProgressVisibility}" Margin="96,0,0,8"/>
                    <CheckBox Content="自动检查 CPA 更新" IsChecked="{Binding CheckForUpdatesOnStartup}" Style="{StaticResource SettingSwitch}" AutomationProperties.Name="自动检查 CPA 更新"/>
                  </StackPanel>
                </Grid>
                </Expander>
              </Border>
            </Grid>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Background="#6623262C" Visibility="{Binding IsTokenDropOverlayVisible, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
      <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36" BorderBrush="{Binding TokenDropAccentBrush}" BorderThickness="2">
        <StackPanel>
          <TextBlock Text="{Binding TokenDropTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding TokenDropSubtitle}" Style="{StaticResource Hint}" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Border>
    <StackPanel x:Name="MainGrowlPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="0,72,24,0" Panel.ZIndex="20"/>
  </Grid>
</hc:Window>
