<hc:Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="CPALauncher.Views.MainWindow" Title="CPA Dock" Width="1120" Height="780" MinWidth="940" MinHeight="660" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Microsoft YaHei UI" FontWeight="Normal" TextOptions.TextFormattingMode="Display" FontSize="14" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <hc:Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <SolidColorBrush x:Key="InkBrush" Color="#252A34"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7A818F"/>
        <SolidColorBrush x:Key="SoftMutedBrush" Color="#A0A6B1"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E4E7ED"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="ActionBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ActionHoverBrush" Color="#ECEFF5"/>
        <SolidColorBrush x:Key="LinkBrush" Color="#5265CE"/>
        <SolidColorBrush x:Key="DockPrimaryBackgroundBrush" Color="#202632"/>
        <SolidColorBrush x:Key="DockPrimaryForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5265CE"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF0FA"/>
        <DrawingImage x:Key="BrandMark">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#202632" Geometry="M12,0 H52 Q64,0 64,12 V52 Q64,64 52,64 H12 Q0,64 0,52 V12 Q0,0 12,0Z"/>
                    <GeometryDrawing Geometry="M18,39 V25 Q18,19 24,19 H43 M36,12 L43,19 L36,26 M46,25 V39 Q46,45 40,45 H21 M28,38 L21,45 L28,52">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="4.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ActionBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource DockPrimaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DockPrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DockPrimaryBackgroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
            <Setter Property="Padding" Value="6,7"/>
        </Style>
        <Style x:Key="Chrome" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Nav" CornerRadius="0" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Nav" Property="Background" Value="{DynamicResource ActionHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainNavigation" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="36,20,36,24"/>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.FontWeight="Normal" Margin="36,0,36,28"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigation" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="164"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TabPanel IsItemsHost="True" Margin="0,0,16,0"/>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.FontWeight="Normal"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <DockPanel Margin="24,0,8,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource Chrome}" Content="" ToolTip="最小化" AutomationProperties.Name="最小化" Click="OnMinimizeClick"/>
                    <Button Style="{StaticResource Chrome}" Content="" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原" Click="OnMaximizeRestoreClick"/>
                    <Button Style="{StaticResource Chrome}" Content="" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口" Click="OnCloseClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource BrandMark}" Width="32" Height="32" Margin="0,0,12,0"/>
                    <TextBlock Text="CPA Dock" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" Padding="32,9" Visibility="{Binding IsImportNoticeVisible, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding ImportNoticeText}" TextWrapping="Wrap"/>
        </Border>
        <TabControl Grid.Row="2" Style="{StaticResource MainNavigation}" SelectedIndex="{Binding SelectedPage}">
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <Border Style="{StaticResource Card}" Padding="32" Visibility="{Binding WelcomeVisibility}">
                            <StackPanel>
                                <TextBlock Text="添加 CPA" FontSize="28" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,28,0,0">
                                    <Button Content="安装 CPA" Command="{Binding InstallCpaCommand}" Margin="0,0,12,0" Style="{StaticResource Primary}"/>
                                    <Button Content="选择已有安装" Command="{Binding GoSettingsCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Hint}" Margin="0,18,0,0" Visibility="{Binding UpdateStatusVisibility}"/>
                                <ProgressBar Height="3" Value="{Binding UpdateProgress}" Maximum="100" Margin="0,12,0,0" Visibility="{Binding UpdateProgressVisibility}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="30" Visibility="{Binding ServiceVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CLIProxyAPI" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusForegroundBrush}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="32" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hint}" Margin="20,12,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                        <Button Content="管理页  ↗" Command="{Binding OpenManagementCommand}" Visibility="{Binding ReadyActionVisibility}" MinWidth="116" Style="{StaticResource Primary}"/>
                                        <Button Content="启动 CPA" Command="{Binding StartCommand}" Visibility="{Binding StartActionVisibility}" MinWidth="116" Style="{StaticResource Primary}"/>
                                        <Button Content="停止" Command="{Binding StopCommand}" Visibility="{Binding StopActionVisibility}" Margin="10,0,0,0"/>
                                        <Button Content="诊断" Command="{Binding GoDiagnosticsCommand}" Visibility="{Binding ExternalNoticeVisibility}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="服务地址" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                            <DockPanel>
                                                <Button Content="复制" Command="{Binding CopyServiceUrlCommand}" DockPanel.Dock="Right" Padding="8,3" Style="{StaticResource Link}"/>
                                                <TextBlock Text="{Binding EndpointDisplay}" FontFamily="Consolas" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="管理密钥" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                            <DockPanel>
                                                <Button Content="复制" Command="{Binding CopyManagementSecretKeyCommand}" DockPanel.Dock="Right" Padding="8,3" Style="{StaticResource Link}"/>
                                                <TextBlock Text="{Binding ManagementSecretKeyDisplay}" FontFamily="Consolas" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,25,4,25" Margin="0,8,0,0" Visibility="{Binding ServiceVisibility}">
                            <DockPanel>
                                <Button Content="导入" Command="{Binding ImportCredentialsCommand}" DockPanel.Dock="Right" MinWidth="80" ToolTip="{Binding CredentialActivationHint}"/>
                                <StackPanel>
                                    <TextBlock Text="凭证" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CredentialsSummary}" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DockPanel Margin="4,26,4,14">
                            <Button Content="全部日志  →" Command="{Binding GoDiagnosticsCommand}" DockPanel.Dock="Right" Padding="0,0" Style="{StaticResource Link}"/>
                            <TextBlock Text="最近日志" FontSize="14" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding LatestActivityText}" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="4,0,4,0" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel Margin="-2,30,0,0">
                            <Button Content="日志目录" Command="{Binding OpenLogsCommand}" Margin="0,0,20,0" Style="{StaticResource Link}"/>
                            <Button Content="设置" Command="{Binding GoSettingsCommand}" Style="{StaticResource Link}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="诊断">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,24">
                        <Button Content="检查" Command="{Binding RefreshCommand}" DockPanel.Dock="Right"/>
                        <TextBlock Text="诊断" FontSize="24" FontWeight="SemiBold"/>
                    </DockPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="进程" Style="{StaticResource Hint}"/>
                                <TextBlock Text="{Binding ProcessCheckText}" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="配置" Style="{StaticResource Hint}"/>
                                <TextBlock Text="{Binding ConfigurationCheckText}" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="HTTP" Style="{StaticResource Hint}"/>
                                <TextBlock Text="{Binding HttpCheckText}" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ProbeUrlDisplay}" Style="{StaticResource Hint}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <DockPanel Grid.Row="2" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Grid Width="220" Margin="0,0,12,0">
    <TextBox x:Name="LogSearchBox" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索日志"/>
    <TextBlock Text="搜索日志" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SoftMutedBrush}" IsHitTestVisible="False" FontSize="13">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
        <DataTrigger Binding="{Binding ElementName=LogSearchBox, Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
  </Grid>
                            <ComboBox Foreground="{DynamicResource InkBrush}" SelectedIndex="{Binding LogScope}" Width="120" VerticalContentAlignment="Center" AutomationProperties.Name="日志筛选">
                                <ComboBoxItem Foreground="{DynamicResource InkBrush}" Content="全部日志"/>
                                <ComboBoxItem Foreground="{DynamicResource InkBrush}" Content="错误与失败"/>
                                <ComboBoxItem Foreground="{DynamicResource InkBrush}" Content="启动器"/>
                                <ComboBoxItem Foreground="{DynamicResource InkBrush}" Content="CPA 输出"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="日志" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Grid.Row="3" Padding="8" CornerRadius="8">
                        <Grid>
                            <TextBlock Text="无" Foreground="{DynamicResource SoftMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=DiagnosticListBox, Path=Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox x:Name="DiagnosticListBox" ItemsSource="{Binding DiagnosticView}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InkBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsVisibleChanged="OnDiagnosticVisibilityChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="复制当前" Command="{Binding CopyVisibleLogsCommand}" Style="{StaticResource Link}"/>
                            <Button Content="复制全部" Command="{Binding CopyLogsCommand}" Style="{StaticResource Link}"/>
                            <Button Content="导出" Command="{Binding ExportLogsCommand}" Style="{StaticResource Link}"/>
                            <Button Content="清空" Command="{Binding ClearLogsCommand}" Style="{StaticResource Link}"/>
                        </StackPanel>
                        <CheckBox Content="跟随日志" IsChecked="{Binding AutoScrollLogs}" ToolTip="取消后可停留在历史日志；最多保留 400 行。"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="设置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,24">
                        <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TabControl Grid.Row="1" Style="{StaticResource SettingsNavigation}" SelectedIndex="{Binding SelectedSettingsPage}">
                        <TabItem Header="服务配置">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <DockPanel Margin="0,0,0,22">
                                        <Button Content="{Binding ConfigurationVisibilityActionText}" Command="{Binding ToggleConfigurationInfoVisibilityCommand}" DockPanel.Dock="Right" ToolTip="{Binding ConfigurationInfoVisibilityToolTip}" Style="{StaticResource Link}"/>
                                        <TextBlock Text="服务配置" FontSize="17" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Card}" Padding="24,20,24,4">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,18">
                                                <DockPanel Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <Button Content="目录" Command="{Binding OpenExecutableDirCommand}" Padding="6,0" Style="{StaticResource Link}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="程序" FontSize="13" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <Button Content="选择" Command="{Binding BrowseExecutableCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                                                    <TextBox Text="{Binding ExecutablePathDisplay, Mode=OneWay}" ToolTip="{Binding ExecutablePathDisplay}" IsReadOnly="True" FontSize="12" AutomationProperties.Name="程序"/>
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,18">
                                                <DockPanel Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <Button Content="编辑" Command="{Binding OpenConfigurationFileCommand}" Margin="0,0,12,0" Padding="6,0" Style="{StaticResource Link}"/>
                                                        <Button Content="目录" Command="{Binding OpenConfigDirCommand}" Padding="6,0" Style="{StaticResource Link}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="配置" FontSize="13" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <Button Content="选择" Command="{Binding BrowseConfigCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                                                    <TextBox Text="{Binding ConfigPathDisplay, Mode=OneWay}" ToolTip="{Binding ConfigPathDisplay}" IsReadOnly="True" FontSize="12" AutomationProperties.Name="配置"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="连接" FontSize="14" FontWeight="SemiBold" Margin="2,24,0,18"/>
                                    <StackPanel Margin="2,0,0,0">
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="监听" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{Binding ListenerDisplay}" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="管理页" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{Binding ManagementUrlDisplay}" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="凭证目录" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{Binding AuthDirectoryDisplay}" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <WrapPanel Margin="-6,6,0,0">
                                            <Button Content="凭证目录" Command="{Binding OpenAuthDirectoryCommand}" Margin="0,0,20,0" Style="{StaticResource Link}"/>
                                            <Button Content="日志目录" Command="{Binding OpenLogsCommand}" Style="{StaticResource Link}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="启动与行为">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="启动与行为" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,22"/>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,22">
                                                <CheckBox Content="登录时打开启动器" IsChecked="{Binding LaunchOnWindowsStartup}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,22">
                                                <CheckBox Content="自动启动 CPA" IsChecked="{Binding AutoStartService}"/>
                                            </StackPanel>
                                            <DockPanel Margin="24,0,0,24">
                                                <hc:NumericUpDown Value="{Binding AutoStartDelaySeconds}" Minimum="0" Maximum="300" Width="100" HorizontalAlignment="Right" DockPanel.Dock="Right" AutomationProperties.Name="启动延迟秒数"/>
                                                <TextBlock Text="启动延迟 / 秒" Style="{StaticResource Hint}"/>
                                            </DockPanel>
                                            <StackPanel Margin="0,0,0,22">
                                                <CheckBox Content="启动后打开管理页" IsChecked="{Binding OpenManagementPageAfterStart}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,22">
                                                <CheckBox Content="关闭到托盘" IsChecked="{Binding MinimizeToTrayOnClose}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="退出启动器" Command="{Binding ExitApplicationCommand}" HorizontalAlignment="Left" Margin="0,24,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="外观">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="外观" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,22"/>
                                    <Border Style="{StaticResource Card}">
                                        <CheckBox Content="深色模式" IsChecked="{Binding IsDarkMode}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="版本更新">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <DockPanel Margin="0,0,0,16">
                                        <Button Content="检查全部" Command="{Binding CheckAllUpdatesCommand}" DockPanel.Dock="Right"/>
                                        <TextBlock Text="版本更新" FontSize="16" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button Content="{Binding LauncherUpdateActionText}" Command="{Binding CheckLauncherUpdateCommand}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="CPA Dock" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding LauncherCurrentVersionDisplay}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding LauncherUpdateStatusText}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                                            <ProgressBar Height="4" Maximum="100" Value="{Binding LauncherUpdateProgress}" Visibility="{Binding LauncherUpdateProgressVisibility}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button Content="{Binding UpdateActionText}" Command="{Binding CheckForUpdateCommand}" DockPanel.Dock="Right" Margin="16,0,0,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="CLIProxyAPI" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CurrentCpaVersionDisplay}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                                            <ProgressBar Height="4" Maximum="100" Value="{Binding UpdateProgress}" Visibility="{Binding UpdateProgressVisibility}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="0,0,0,22">
                                        <CheckBox Content="自动检查 CPA 更新" IsChecked="{Binding CheckForUpdatesOnStartup}"/>
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Content="GitHub  ↗" Command="{Binding OpenRepositoryCommand}" Margin="-6,0,14,0" Style="{StaticResource Link}"/>
                                        <Button Content="CLIProxyAPI  ↗" Command="{Binding OpenCpaRepositoryCommand}" Style="{StaticResource Link}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <DockPanel>
                <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource Hint}" DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Fill="{Binding StatusForegroundBrush}" Width="6" Height="6" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding FooterStatusText}" Style="{StaticResource Hint}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.RowSpan="4" Background="#88131F18" Visibility="{Binding IsTokenDropOverlayVisible, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
            <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36" BorderBrush="{Binding TokenDropAccentBrush}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{Binding TokenDropTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TokenDropSubtitle}" Style="{StaticResource Hint}" Margin="0,12,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
        <StackPanel x:Name="MainGrowlPanel" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="0,72,24,0" Panel.ZIndex="20"/>
    </Grid>
</hc:Window>
